# Server
PORT=3000
NODE_ENV=development

# Tenant resolution: strip this from Host to get subdomain (e.g. acfc.localhost:3000 → acfc)
APP_DOMAIN=localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sportbooker
DB_USER=postgres
DB_PASSWORD=postgres

# Pool config (optional) – max connections, timeouts
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MILLIS=10000
DB_POOL_CONNECTION_TIMEOUT_MILLIS=5000
DB_STATEMENT_TIMEOUT_MILLIS=30000

# JWT access token – short-lived, used for API auth
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Stripe – secret key and webhook signing secret
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SendGrid – API key and From address for transactional email
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@example.com

# Optional. Min 32 chars. In production, enables /api/docs + /api/docs-json and protects them with Bearer auth (for Orval CI).
# OPENAPI_DOCS_TOKEN=

# Comma-separated allowed browser origins for CORS. Empty = no CORS. Example: Vercel + local SPA port
CORS_ORIGINS=http://localhost:5173,https://sport-booker-fe.vercel.app
