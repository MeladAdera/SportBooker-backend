PORT=3000
NODE_ENV=development

# Set NODE_ENV=production to disable Swagger UI at /api/docs
# Tenant resolution: strip this from Host to get subdomain (e.g. localhost:3000, sportbooker.com)
APP_DOMAIN=localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sportbooker
DB_USER=postgres
DB_PASSWORD=postgres

# Pool config (optional, defaults shown)
# DB_POOL_MAX=20
# Multi-tenant systems consume more connections (tenant lookup + business logic per request).
# Consider 20–25 for moderate load; tune based on concurrent request volume.
# DB_POOL_IDLE_TIMEOUT_MILLIS=10000
# DB_POOL_CONNECTION_TIMEOUT_MILLIS=5000
# DB_STATEMENT_TIMEOUT_MILLIS=30000
